#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## These messages are printf, not 'true "..."'.
##
## The original relied on 'set -x' to make its 'true' lines visible: xtrace
## echoes the command, so the string reached the terminal as a side effect.
## Removing the left-on 'set -x' -- part of this pass -- therefore made the
## script SILENT: no backup location, no "change your Tor circuit before
## reconnecting" warning, and no "Do not run as root!" before exiting 112.

error_handler() {
   ## Reached only through the ERR trap below.
   # shellcheck disable=SC2317
   true "ERROR!"
   exit 1
}

trap error_handler ERR

if [ "$(id -u)" = "0" ]; then
      printf '%s\n' "Do not run as root!" >&2
      exit 112
fi

printf '%s\n' "INFO: Resetting your IRC XChat identity..."
killall xchat || true

## Make a backup
datestring="$(date '+%F-%H:%M:%S')"
backup_folder=~/xchat_${datestring}
if [ -d ~/.xchat2 ]; then
   mv -- ~/.xchat2 "${backup_folder}"
fi

## XChat settings from:
## https://gitlab.torproject.org/legacy/trac/-/wikis/doc/TorifyHOWTO/XChat

## Copy config files.
mkdir --parents ~/.xchat2
cp -r /etc/skel/.xchat2 ~/

printf '%s\n' "INFO: Done."
printf '%s\n' "INFO: A backup can be found: ${backup_folder} - feel free to delete it."
printf '%s\n' "INFO: Be sure to change your Tor circuit before reconnecting to IRC!"
